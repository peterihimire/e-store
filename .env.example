# .env.example - Copy to .env and fill in your values

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/estore_database
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_secret_key_here
JWT_EXPIRATION=3600000

# Server Configuration
SERVER_PORT=8080
API_PREFIX=/api/v1

# CORS — FRONTEND_BASE_URL is always allowed; add others as a comma-separated list
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# OpenAPI / Swagger UI — http://localhost:8080/swagger-ui.html
OPENAPI_SERVER_URL=http://localhost:8080
OPENAPI_SERVER_DESCRIPTION=Local development
APP_VERSION=1.0.0

# Docker (optional — overrides the image name used by the compose files)
# DOCKER_IMAGE=<dockerhub-username>/estore
# IMAGE_TAG=latest

# File Upload
UPLOAD_DIR=/path/to/uploads

# Email
# Use mailtrap, brevo (SMTP) or mailgun (HTTP API)
EMAIL_PROVIDER=mailtrap
MAIL_FROM=hello@estore.com
MAIL_FROM_NAME=Estore

# Mailgun — required when EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_REGION=us
MAILGUN_CONNECT_TIMEOUT_MS=10000
MAILGUN_RESPONSE_TIMEOUT_MS=10000

# Notification delivery (outbox + after-commit send + retry worker)
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=500
NOTIFICATION_CLAIM_LEASE_MS=60000
NOTIFICATION_SCAN_DELAY_MS=30000
NOTIFICATION_RETRY_BATCH_SIZE=50
NOTIFICATION_DISPATCH_THREADS=4
NOTIFICATION_QUEUE_CAPACITY=200